# === Server-side secrets (used only by server.ts / Express API routes) ===
# GEMINI_API_KEY: primary Gemini key for the chatbot + AI fair-price estimator.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_API_KEY_2: fallback key — used automatically when the primary hits
# its rate/quota limit.
GEMINI_API_KEY_2="MY_SECOND_GEMINI_API_KEY"
# WEATHER_API_KEY: OpenWeatherMap key for /api/weather.
WEATHER_API_KEY="e8a935ba004f42d5370d92df7444c2cb"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# === Client-side (Vite, bundled into the app — must be a public/restricted key) ===
# VITE_GOOGLE_MAPS_API_KEY: Google Maps JavaScript API key for the 3D map view.
# Restrict it in Google Cloud Console to your Android package name + SHA-1
# fingerprint (see ANDROID_BUILD.md).
VITE_GOOGLE_MAPS_API_KEY="AIzaSyD3oxW2Y7T9UTUsCTHlmGE_rVAYIDmf6f0"